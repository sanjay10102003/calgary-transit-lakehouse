<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs the poller in the background and restarts it if it dies.
  Replace REPO_PATH, copy to ~/Library/LaunchAgents/, then:
    launchctl load ~/Library/LaunchAgents/com.calgarytransit.poller.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.calgarytransit.poller</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPO_PATH/poller/run_poller.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>REPO_PATH/logs/poller.log</string>
  <key>StandardErrorPath</key><string>REPO_PATH/logs/poller.err</string>
</dict>
</plist>
